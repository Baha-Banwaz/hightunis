# Copy to .env.local and fill in. .env* is gitignored (except this file).

# --- Public: compiled into the browser bundle. Never put a secret here. ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Server only: never prefixed with NEXT_PUBLIC_. ---
# Bypasses RLS. Used by the /api routes only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Single shared password for /admin/login.
ADMIN_PASSWORD=choose-a-long-random-password
# Signs the admin session cookie. Generate with: openssl rand -hex 32
# Rotating this invalidates every live admin session.
ADMIN_SESSION_SECRET=generate-with-openssl-rand-hex-32
# CARTO basemaps key, for the map on /listings. Free, no account: request it
# at https://carto.com/basemaps/apikey and it arrives by email.
#
# NEXT_PUBLIC_ on purpose. The key is a query parameter on every tile URL, so
# it is visible to anyone who opens the network tab; it is not a secret and
# cannot be made one. Restrict it to your domains in the CARTO dashboard,
# which is what actually protects it.
#
# Unset, the map does not render at all. CARTO answers a keyless request with
# a tile stamped "API KEY REQUIRED" rather than an error.
NEXT_PUBLIC_CARTO_KEY=your-carto-basemaps-key
